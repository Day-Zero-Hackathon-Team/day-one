# Meterless Nightshift (the app's AI provider). Copy to .env and fill in; never commit .env.
# The token is in %LOCALAPPDATA%\ai.meterless.runtime\proxy-token (Windows) or
# ~/Library/Application Support/ai.meterless.runtime/proxy-token (macOS) on the machine running Nightshift.
# Leave it empty on that machine and the client reads the file itself.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=day-one

# true = replay recorded responses from samples/nightshift/ (no Nightshift, no keys needed)
SAMPLE_MODE=false
# true = record live responses into samples/nightshift/ and samples/zetaris/ to build the sample set
NIGHTSHIFT_RECORD=false
ZETARIS_RECORD=false

# The NVIDIA API key does NOT go here. It lives in Nightshift's Providers tab.

# Zetaris: your unzipped zetaris-platform folder. Found automatically next to this repo, in your
# home folder or in Downloads; set it if yours is elsewhere. Login is read from its .env.
ZETARIS_DIR=

# Web server
PORT=3100
# Safety checker: highest Flesch-Kincaid grade allowed per section (target is grade 6)
READING_GRADE_MAX=8

# Routes (Nightshift picks the model; these pick the routing mode)
VISION_ROUTE=meterless/vision
SAFETY_ROUTE=meterless/text

# Interface to listen on (default 127.0.0.1, this machine only). Leave it unset for Docker: the image sets 0.0.0.0.
# HOST=127.0.0.1
# Run logs go to stdout and here (one logs/trace-<run_id>.jsonl per run)
# LOG_DIR=logs
# npm run agent / POST /api/run give up waiting after this many seconds (structured RunTimeout error)
# RUN_TIMEOUT_SECONDS=900

# Docker only: a container can't reach localhost on your machine or read Nightshift's token file,
# so also fill in METERLESS_RUNTIME_TOKEN above and use these addresses:
# METERLESS_BASE_URL=http://host.docker.internal:8088/v1
# ZETARIS_URL=jdbc:zetaris:lightning@host.docker.internal:10000
