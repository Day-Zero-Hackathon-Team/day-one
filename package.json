{
  "name": "day-one",
  "private": true,
  "type": "module",
  "description": "Discharge summary agent pipeline (Open Agent Hackathon 2026)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --experimental-transform-types --no-warnings src/server.ts",
    "sample": "node --experimental-transform-types --no-warnings --env-file-if-exists=.env.sample src/server.ts",
    "agent": "node --experimental-transform-types --no-warnings scripts/run.ts",
    "agent:sample": "node --experimental-transform-types --no-warnings --env-file-if-exists=.env.sample scripts/run.ts",
    "test": "node --experimental-transform-types --no-warnings --test \"src/**/*.test.ts\"",
    "test:hmem": "node --experimental-transform-types --no-warnings engines/hmem/conformance/runner.ts",
    "nightshift:check": "node --experimental-transform-types --no-warnings scripts/nightshift_check.ts",
    "samples:record": "node --experimental-transform-types --no-warnings scripts/record_samples.ts",
    "zetaris:usl": "node --experimental-transform-types --no-warnings scripts/zetaris_usl.ts"
  }
}
