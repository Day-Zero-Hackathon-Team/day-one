          "bullets": [
            {
              "id": "a3",
              "text": "Eat a low salt diet. Limit salt to 2 grams each day.",
              "sources": [
                "p1:L19"
              ]
            },
            {
              "id": "a4",
              "text": "Drink no more than 1.5 liters of fluid each day.",
              "sources": [
                "p1:L19"
              ]
            },
            {
              "id": "a5",
              "text": "Weigh yourself every morning before breakfast and write it down.",
              "sources": [
